crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Sensitive credentials
*.pem
*.key
.aws/

# Environment files
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/
